{
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*",
		"#features/*": "./src/features/*",
		"#generated/*": "./generated/*"
	},
	"scripts": {
		"dev": "tsx watch src/app.ts",
		"dev:frontend": "pnpm --dir frontend dev",
		"dev:all": "concurrently -n server,client -c blue,magenta \"pnpm dev\" \"pnpm dev:frontend\"",
		"start": "tsx src/app.ts",
		"prisma:generate": "prisma generate",
		"prisma:migrate": "prisma migrate dev",
		"prisma:studio": "prisma studio"
	},
	"devDependencies": {
		"@types/cookie-parser": "^1.4.10",
		"@types/express": "^5.0.6",
		"@types/node": "^26.4.1",
		"@types/pg": "^8.23.1",
		"concurrently": "^10.0.5",
		"prisma": "^7.10.0",
		"tsx": "^4.23.13",
		"typescript": "^7.0.2"
	},
	"dependencies": {
		"@prisma/adapter-pg": "^7.10.0",
		"@prisma/client": "^7.10.0",
		"argon2": "^0.45.1",
		"cookie-parser": "^1.4.7",
		"dotenv": "^17.4.2",
		"express": "^5.2.1",
		"helmet": "^8.3.0",
		"jose": "^6.2.10",
		"pg": "^8.23.0",
		"zod": "^4.5.4"
	}
}
